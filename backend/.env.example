# Which vision model powers extraction: "gemini" (free tier, good for testing)
# or "anthropic" (paid, use for production). Default: anthropic
EXTRACTION_PROVIDER=gemini

# Only needed if EXTRACTION_PROVIDER=anthropic
# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only needed if EXTRACTION_PROVIDER=gemini
# Get this free at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Port the extraction API runs on
PORT=4000

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Odoo cross-check + quotation creation - ALL FOUR must be set together for
# live mode. If any is missing, the app safely falls back to dummy/mock
# Odoo data (good for testing without touching a real instance).
# Get ODOO_API_KEY from: Odoo -> your profile -> Account Security -> New API Key
# (a password also works technically, but an API key is revocable and safer)
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
ODOO_USERNAME=you@yourcompany.com
ODOO_API_KEY=replace-with-your-odoo-api-key
