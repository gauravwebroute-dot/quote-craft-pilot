# ==========================================
# OpenRouter Configuration (Recommended)
# One unified API key for Gemini, Claude & Llama/Groq
# ==========================================
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-api-key

# Default model when not explicitly passed by frontend:
# google/gemini-2.0-flash-001 (Fast, free/cheap, high accuracy)
# anthropic/claude-3.5-sonnet (High precision blueprints)
# meta-llama/llama-3.2-11b-vision-instruct (Ultra-fast vision via Groq)
DEFAULT_EXTRACTION_MODEL=google/gemini-2.0-flash-001

# ==========================================
# Legacy / Direct Provider Config (Optional fallback)
# Only needed if NOT using OpenRouter
# ==========================================
# EXTRACTION_PROVIDER=gemini
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=replace-with-your-gemini-api-key

# Port the extraction API runs on
PORT=4000

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Odoo cross-check + quotation creation - ALL FOUR must be set together for
# live mode. If any is missing, the app safely falls back to dummy/mock
# Odoo data (good for testing without touching a real instance).
# Get ODOO_API_KEY from: Odoo -> your profile -> Account Security -> New API Key
# (a password also works technically, but an API key is revocable and safer)
ODOO_URL=https://yourcompany.odoo.com
ODOO_DB=yourcompany
ODOO_USERNAME=you@yourcompany.com
ODOO_API_KEY=replace-with-your-odoo-api-key
